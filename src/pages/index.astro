---
import "../styles/global.css";
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>কোড বাংলা — বাংলায় প্রোগ্রামিং</title>
    <meta name="description" content="বাংলা ভাষায় প্রোগ্রামিং শেখো, লেখো, এবং তৈরি করো। কোড বাংলা — উন্মুক্ত সোর্স প্রোগ্রামিং ভাষা।" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Noto+Sans+Bengali:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0a0a0f] text-white font-['Hind_Siliguri',sans-serif] overflow-x-hidden">

    <!-- Ambient background blobs -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-green-600/10 blur-[120px]"></div>
      <div class="absolute top-[30%] right-[-10%] w-[500px] h-[500px] rounded-full bg-emerald-500/8 blur-[100px]"></div>
      <div class="absolute bottom-[-10%] left-[30%] w-[700px] h-[400px] rounded-full bg-teal-600/8 blur-[120px]"></div>
    </div>

    <!-- ── NAVBAR ── -->
    <nav class="relative z-50 flex items-center justify-between px-6 md:px-16 py-5 border-b border-white/5 backdrop-blur-sm bg-black/20">
      <div class="flex items-center gap-3">
        <!-- Logo mark -->
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-black font-bold text-lg select-none">
          ক
        </div>
        <span class="text-white font-semibold text-lg tracking-wide">কোড বাংলা</span>
      </div>
      <div class="hidden md:flex items-center gap-8 text-sm text-white/60">
        <a href="#features" class="hover:text-green-400 transition-colors">বৈশিষ্ট্য</a>
        <a href="#syntax" class="hover:text-green-400 transition-colors">সিনট্যাক্স</a>
        <a href="#community" class="hover:text-green-400 transition-colors">সম্প্রদায়</a>
        <a href="#roadmap" class="hover:text-green-400 transition-colors">রোডম্যাপ</a>
      </div>
      <a
        href="mailto:code-bangla@googlegroups.com"
        class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-green-500/10 border border-green-500/30 text-green-400 text-sm hover:bg-green-500/20 transition-all"
      >
        যোগ দাও
      </a>
    </nav>

    <!-- ── HERO ── -->
    <section class="relative z-10 flex flex-col items-center text-center px-6 pt-24 pb-20 md:pt-36 md:pb-28">

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-green-500/30 bg-green-500/5 text-green-400 text-xs font-medium mb-8 tracking-widest uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
        উন্মুক্ত সোর্স · সক্রিয় উন্নয়ন
      </div>

      <!-- Headline -->
      <!-- Main headline -->
      <h1 class="inline-flex items-center gap-4 text-5xl md:text-7xl lg:text-8xl font-black leading-tight mb-6 font-['Noto_Sans_Bengali',sans-serif]">
        <span class="text-white">ভাষা হোক উন্মুক্ত</span>
        <span class="text-5xl md:text-6xl">🇧🇩</span>
      </h1>

      <p class="max-w-2xl text-white/50 text-lg md:text-xl leading-relaxed mb-10">
        বিশ্বের প্রথম বাংলা প্রোগ্রামিং ভাষা — যেখানে প্রতিটি কীওয়ার্ড, প্রতিটি নির্দেশ
        তোমার মাতৃভাষায়। কোড লেখো স্বাভাবিকভাবে, ভাবো বাংলায়।
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#syntax"
          class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-green-500 to-emerald-500 text-black font-bold text-base hover:from-green-400 hover:to-emerald-400 transition-all shadow-lg shadow-green-500/25"
        >
          সিনট্যাক্স দেখো
        </a>
        <a
          href="mailto:code-bangla@googlegroups.com"
          class="px-8 py-3.5 rounded-xl border border-white/10 bg-white/5 text-white/80 font-medium text-base hover:bg-white/10 hover:border-white/20 transition-all"
        >
          কমিউনিটিতে যোগ দাও
        </a>
      </div>

      <!-- Domain pill -->
      <div class="mt-10 text-white/20 text-sm tracking-widest">
        🌐 &nbsp;<span class="text-white/40 font-mono">কোড.বাংলা</span>
      </div>

    </section>

    <!-- ── CODE PREVIEW ── -->
    <section id="syntax" class="relative z-10 px-6 md:px-16 py-16">
      <div class="max-w-4xl mx-auto">

        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-white/90 mb-2 font-['Noto_Sans_Bengali',sans-serif]">দেখতে কেমন?</h2>
          <p class="text-white/40 text-sm">পরিচিত ধারণা, বাংলা সিনট্যাক্স</p>
        </div>

        <!-- Code card -->
        <div class="rounded-2xl overflow-hidden border border-white/8 shadow-2xl shadow-black/60">
          <!-- Window chrome -->
          <div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5">
            <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
            <span class="ml-3 text-white/20 text-xs font-mono">ফিবোনাচি.বাংলা</span>
          </div>
          <!-- Code body -->
          <div class="bg-[#0d1117] p-6 md:p-8 overflow-x-auto">
            <pre class="text-sm md:text-base leading-8 font-mono"><code><span class="text-purple-400">ফাংশন</span> <span class="text-green-300">ফিবোনাচি</span>(<span class="text-orange-300">সংখ্যা</span>) &#123;
  <span class="text-purple-400">যদি</span> (<span class="text-orange-300">সংখ্যা</span> <span class="text-white/60">&lt;=</span> <span class="text-blue-300">১</span>) &#123;
    <span class="text-purple-400">ফেরত</span> <span class="text-orange-300">সংখ্যা</span>;
  &#125;
  <span class="text-purple-400">ফেরত</span> <span class="text-green-300">ফিবোনাচি</span>(<span class="text-orange-300">সংখ্যা</span> <span class="text-white/60">-</span> <span class="text-blue-300">১</span>) <span class="text-white/60">+</span> <span class="text-green-300">ফিবোনাচি</span>(<span class="text-orange-300">সংখ্যা</span> <span class="text-white/60">-</span> <span class="text-blue-300">২</span>);
&#125;

<span class="text-purple-400">প্রতিটি</span> <span class="text-orange-300">ক্রম</span> <span class="text-purple-400">এ</span> [<span class="text-blue-300">০</span>, <span class="text-blue-300">১</span>, <span class="text-blue-300">২</span>, <span class="text-blue-300">৩</span>, <span class="text-blue-300">৪</span>, <span class="text-blue-300">৫</span>, <span class="text-blue-300">৬</span>, <span class="text-blue-300">৭</span>, <span class="text-blue-300">৮</span>, <span class="text-blue-300">৯</span>, <span class="text-blue-300">১০</span>] &#123;
  <span class="text-yellow-300">দেখাও</span>(<span class="text-green-300">ফিবোনাচি</span>(<span class="text-orange-300">ক্রম</span>));
&#125;</code></pre>
          </div>
          <!-- Output strip -->
          <div class="bg-black/40 border-t border-white/5 px-6 py-3 flex items-center gap-3">
            <span class="text-white/20 text-xs font-mono">আউটপুট →</span>
            <span class="text-green-400 font-mono text-xs">০, ১, ১, ২, ৩, ৫, ৮, ১৩, ২১, ৩৪, ৫৫</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ── FEATURES ── -->
    <section id="features" class="relative z-10 px-6 md:px-16 py-20">
      <div class="max-w-6xl mx-auto">

        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-black text-white mb-3 font-['Noto_Sans_Bengali',sans-serif]">কেন কোড বাংলা?</h2>
          <p class="text-white/40 max-w-xl mx-auto">আমাদের ভাষায় চিন্তা করার শক্তি, কোডে রূপ দেওয়ার স্বাধীনতা।</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

          <!-- Feature card -->
          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-xl mb-4">🔤</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">সম্পূর্ণ বাংলা সিনট্যাক্স</h3>
            <p class="text-white/40 text-sm leading-relaxed">কীওয়ার্ড থেকে অপারেটর — সব কিছুই বাংলা হরফে। কোনো ইংরেজি মুখস্থ করার প্রয়োজন নেই।</p>
          </div>

          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-xl mb-4">⚡</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">দ্রুত ও হালকা</h3>
            <p class="text-white/40 text-sm leading-relaxed">কম রিসোর্সে বেশি কাজ। পুরনো কম্পিউটারেও সাবলীলভাবে চলে।</p>
          </div>

          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-xl mb-4">📖</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">বাংলায় ডকুমেন্টেশন</h3>
            <p class="text-white/40 text-sm leading-relaxed">সম্পূর্ণ ডকুমেন্টেশন বাংলায়। শেখার কোনো ভাষাগত বাধা নেই।</p>
          </div>

          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-xl mb-4">🌍</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">উন্মুক্ত সোর্স</h3>
            <p class="text-white/40 text-sm leading-relaxed">সবার জন্য, সবার দ্বারা। যে কেউ অবদান রাখতে পারবে।</p>
          </div>

          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-xl mb-4">🎓</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">শিক্ষার উপযোগী</h3>
            <p class="text-white/40 text-sm leading-relaxed">স্কুল থেকে বিশ্ববিদ্যালয় — সব স্তরের শিক্ষার্থীদের জন্য আদর্শ।</p>
          </div>

          <div class="group p-6 rounded-2xl border border-white/6 bg-white/2 hover:border-green-500/30 hover:bg-green-500/3 transition-all">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-xl mb-4">🤝</div>
            <h3 class="text-white font-semibold text-lg mb-2 font-['Noto_Sans_Bengali',sans-serif]">সক্রিয় সম্প্রদায়</h3>
            <p class="text-white/40 text-sm leading-relaxed">বাংলাদেশ ও ভারতের হাজারো ডেভেলপারের একটি উৎসাহী সম্প্রদায়।</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── ROADMAP ── -->
    <section id="roadmap" class="relative z-10 px-6 md:px-16 py-20">
      <div class="max-w-3xl mx-auto">

        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-black text-white mb-3 font-['Noto_Sans_Bengali',sans-serif]">রোডম্যাপ</h2>
          <p class="text-white/40">আমরা কোথায় যাচ্ছি</p>
        </div>

        <div class="space-y-4">
          <!-- Step -->
          <div class="flex gap-5 items-start p-5 rounded-2xl bg-green-500/5 border border-green-500/20">
            <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-black font-bold text-sm flex-shrink-0 mt-0.5">✓</div>
            <div>
              <div class="text-green-400 text-xs font-medium uppercase tracking-widest mb-1">সম্পন্ন</div>
              <h4 class="text-white font-semibold font-['Noto_Sans_Bengali',sans-serif]">ভাষার মূল ডিজাইন</h4>
              <p class="text-white/40 text-sm mt-1">গ্রামার, টোকেনাইজার এবং পার্সার ডিজাইন সম্পন্ন।</p>
            </div>
          </div>

          <div class="flex gap-5 items-start p-5 rounded-2xl bg-yellow-500/5 border border-yellow-500/20">
            <div class="w-8 h-8 rounded-full bg-yellow-500 flex items-center justify-center text-black font-bold text-sm flex-shrink-0 mt-0.5">◎</div>
            <div>
              <div class="text-yellow-400 text-xs font-medium uppercase tracking-widest mb-1">চলছে</div>
              <h4 class="text-white font-semibold font-['Noto_Sans_Bengali',sans-serif]">ইন্টারপ্রেটার নির্মাণ</h4>
              <p class="text-white/40 text-sm mt-1">কোর ইন্টারপ্রেটার এবং স্ট্যান্ডার্ড লাইব্রেরি তৈরি হচ্ছে।</p>
            </div>
          </div>

          <div class="flex gap-5 items-start p-5 rounded-2xl bg-white/2 border border-white/6">
            <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white/40 font-bold text-sm flex-shrink-0 mt-0.5">○</div>
            <div>
              <div class="text-white/30 text-xs font-medium uppercase tracking-widest mb-1">পরিকল্পিত</div>
              <h4 class="text-white/70 font-semibold font-['Noto_Sans_Bengali',sans-serif]">VS Code এক্সটেনশন</h4>
              <p class="text-white/30 text-sm mt-1">সিনট্যাক্স হাইলাইটিং, অটো-কমপ্লিট এবং ডিবাগার।</p>
            </div>
          </div>

          <div class="flex gap-5 items-start p-5 rounded-2xl bg-white/2 border border-white/6">
            <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white/40 font-bold text-sm flex-shrink-0 mt-0.5">○</div>
            <div>
              <div class="text-white/30 text-xs font-medium uppercase tracking-widest mb-1">পরিকল্পিত</div>
              <h4 class="text-white/70 font-semibold font-['Noto_Sans_Bengali',sans-serif]">অনলাইন প্লেগ্রাউন্ড</h4>
              <p class="text-white/30 text-sm mt-1">ব্রাউজারেই কোড বাংলা লেখো ও চালাও — কোনো ইনস্টল ছাড়াই।</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── COMMUNITY CTA ── -->
    <section id="community" class="relative z-10 px-6 md:px-16 py-20">
      <div class="max-w-3xl mx-auto text-center">

        <div class="relative rounded-3xl border border-green-500/20 bg-gradient-to-b from-green-500/5 to-transparent p-12 md:p-16 overflow-hidden">
          <!-- Decorative glow -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="w-64 h-64 rounded-full bg-green-500/10 blur-3xl"></div>
          </div>

          <div class="relative z-10">
            <div class="text-5xl mb-6">🌱</div>
            <h2 class="text-3xl md:text-4xl font-black text-white mb-4 font-['Noto_Sans_Bengali',sans-serif]">
              ভাষার ভবিষ্যৎ গড়তে<br/>আমাদের সাথে যোগ দাও
            </h2>
            <p class="text-white/50 mb-8 max-w-lg mx-auto leading-relaxed">
              ডেভেলপার, শিক্ষার্থী, শিক্ষক — সবাই স্বাগত। আমাদের Google Groups-এ যোগ দিয়ে এই আন্দোলনের অংশ হও।
            </p>

            <a
              href="mailto:code-bangla@googlegroups.com"
              class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-green-500 to-emerald-500 text-black font-bold text-base hover:from-green-400 hover:to-emerald-400 transition-all shadow-xl shadow-green-500/30"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              code-bangla@googlegroups.com
            </a>

            <p class="mt-5 text-white/20 text-sm font-mono">কোড.বাংলা · বাংলাভাষা হোক উন্মুক্ত</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ── FOOTER ── -->
    <footer class="relative z-10 border-t border-white/5 px-6 md:px-16 py-8">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-white/25 text-sm">
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 rounded bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-black font-bold text-xs">ক</div>
          <span>কোড বাংলা</span>
          <span class="text-white/10">·</span>
          <span>উন্মুক্ত সোর্স</span>
        </div>
        <span class="font-mono text-xs text-white/15">বাংলাভাষা হোক উন্মুক্ত 🇧🇩</span>
      </div>
    </footer>

  </body>
</html>
